    { "q": "滑雪的人", "expect": [], "tag": "negative", "note": "有雪景但没有滑雪" },
    { "q": "birthday cake", "expect": [], "tag": "negative" },
    { "q": "手机截图", "expect": [], "tag": "negative", "note": "库里没有截图（samsung-one-ui-6.jpg 是一面墙的照片）" },
    { "q": "大象的视频", "expect": [], "tag": "negative", "note": "类型词剥掉后（大象）仍是负例，类型软加权不该把视频硬顶成明确命中" }
  ]
